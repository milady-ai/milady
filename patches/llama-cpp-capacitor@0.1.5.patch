+    /**
+     * Probe the kernels manifest shipped alongside the fork-built native
+     * library. The buun-llama-cpp build script writes
+     * `assets/llama-cpp-kernels.json` (e.g. {"variant":"buun-llama-cpp",
+     * "kernels":["turbo3","turbo4","dflash"]}) into the host APK; stock
+     * builds don't ship that file and we report an empty list.
+     */
+    public Map<String, Object> readNativeKernelsManifest() {
+        Map<String, Object> result = new HashMap<>();
+        List<String> kernels = new ArrayList<>();
+        String variant = "stock-llama-cpp";
+        try {
+            java.io.InputStream is = context.getAssets().open("llama-cpp-kernels.json");
+            try {
+                java.io.ByteArrayOutputStream baos = new java.io.ByteArrayOutputStream();
+                byte[] buf = new byte[1024];
+                int n;
+                while ((n = is.read(buf)) > 0) {
+                    baos.write(buf, 0, n);
+                }
+                String json = baos.toString("UTF-8");
+                org.json.JSONObject obj = new org.json.JSONObject(json);
+                String v = obj.optString("variant", "");
+                if (v.length() > 0) variant = v;
+                org.json.JSONArray arr = obj.optJSONArray("kernels");
+                if (arr != null) {
+                    for (int i = 0; i < arr.length(); i++) {
+                        kernels.add(arr.optString(i, ""));
+                    }
+                }
+            } finally {
+                is.close();
+            }
+        } catch (java.io.FileNotFoundException e) {
+            // Stock build: no kernels manifest. Caller treats as stock-llama-cpp.
+            Log.d(TAG, "llama-cpp-kernels.json not present; assuming stock-llama-cpp");
+        } catch (Exception e) {
+            Log.w(TAG, "Failed to read llama-cpp-kernels.json: " + e.getMessage());
+        }
+        result.put("variant", variant);
+        result.put("kernels", kernels);
+        return result;
+    }
