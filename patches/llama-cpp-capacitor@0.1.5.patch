+    /**
+     * Surface the fork-build kernels manifest to the JS bridge. Returns
+     * { kernels: string[], variant: "buun-llama-cpp" | "stock-llama-cpp" }.
+     * Stock builds always resolve with an empty kernels list.
+     */
+    @PluginMethod
+    public void getNativeKernels(PluginCall call) {
+        Map<String, Object> manifest = implementation.readNativeKernelsManifest();
+        JSObject ret = new JSObject();
+        Object variant = manifest.get("variant");
+        ret.put("variant", variant == null ? "stock-llama-cpp" : variant);
+        JSArray kernelsArr = new JSArray();
+        Object kernelsObj = manifest.get("kernels");
+        if (kernelsObj instanceof List<?>) {
+            for (Object k : (List<?>) kernelsObj) {
+                if (k != null) kernelsArr.put(k.toString());
+            }
+        }
+        ret.put("kernels", kernelsArr);
+        call.resolve(ret);
+    }
