{
  "name": "electrobun-agentic-desktop-2026",
  "version": "1.0.1",
  "created": "2026-05-25",
  "description": "Portable coding-agent plugin/rules pack for building agentic Electrobun desktop apps with TypeScript and Bun.",
  "source_port": "apple-agentic-swift-coding-agent-plugin.zip",
  "entrypoints": {
    "generic": "AGENTS.md",
    "claude": "CLAUDE.md",
    "claude_hooks": ".claude/settings.json",
    "claude_slash_commands": ".claude/commands/",
    "cursor": ".cursor/rules/electrobun-agentic-desktop-2026.mdc",
    "copilot": ".github/copilot-instructions.md",
    "codex": ".codex/AGENTS.md",
    "windsurf": ".windsurfrules"
  },
  "included": [
    "automations",
    "build_lifecycle_hooks",
    "bunfig_template",
    "checklists",
    "docs",
    "github_actions",
    "hooks",
    "porting_matrix",
    "rules",
    "scripts",
    "slash_commands",
    "templates"
  ],
  "electrobun_focus": [
    "Electrobun",
    "Bun",
    "TypeScript",
    "BrowserWindow",
    "BrowserView",
    "Electroview",
    "typed RPC",
    "views:// bundled assets",
    "sandboxed webviews",
    "system tray",
    "application menu",
    "context menu",
    "deep links",
    "updater",
    "ZSTD self-extracting bundles",
    "code signing",
    "notarization",
    "CEF/native webview tradeoffs",
    "Bun.secrets",
    "bun:sqlite",
    "agent orchestration",
    "prompt/tool evals",
    "privacy"
  ],
  "not_ported_from_apple": [
    "SwiftUI implementation code",
    "Foundation Models API symbols",
    "App Intents API symbols",
    "WidgetKit",
    "ActivityKit",
    "App Clips",
    "StoreKit/PassKit",
    "Xcode project files"
  ],
  "notes": "This is an Electrobun coding-agent plugin, not a generated app. Templates are reference implementation skeletons. Verify exact Electrobun, Bun, and TypeScript APIs against installed dependency versions. Updated with Electrobun build lifecycle hook templates, tag release workflow, and stricter webview/navigation guidance."
}
