# syntax=docker/dockerfile:1.7
# elizaOS Agent — CI Docker Image
# Pre-built artifacts come from GHA (bun install + tsdown + vite build done before docker)
ARG NODE_VERSION=22
ARG BUN_VERSION=1.3.10
ARG ESBUILD_VERSION=0.28.0
ARG APP_ENTRYPOINT=app.mjs
ARG APP_CMD_START=""
ARG APP_PORT=2138
ARG APP_API_BIND=127.0.0.1
ARG OCI_SOURCE=""
ARG OCI_TITLE="elizaOS Agent"
ARG OCI_DESCRIPTION="elizaOS agent runtime"
ARG OCI_LICENSES="MIT"
ARG VERSION=""
ARG VERSION_CLEAN=""
ARG REVISION=""

FROM node:${NODE_VERSION}-slim AS pruner
WORKDIR /app
COPY . .

# ===== Replace workspace symlinks with actual compiled packages =====
# Bun workspace symlinks break in Docker. Delete the symlinks entirely
# and replace with the actual package contents + CI-compiled dist/.
RUN set -x; \
    # @elizaos/core: delete symlink, copy package + compiled dist
    rm -rf node_modules/@elizaos/core; \
    mkdir -p node_modules/@elizaos/core; \
    cp eliza/packages/typescript/package.json node_modules/@elizaos/core/; \
    cp -a eliza/packages/typescript/dist node_modules/@elizaos/core/dist 2>/dev/null || true; \
    # NOTE: Do NOT copy src/ - tsx will prefer raw .ts over compiled dist/
    # cp -a eliza/packages/typescript/src node_modules/@elizaos/core/src 2>/dev/null || true; \
    ls node_modules/@elizaos/core/dist/node/index.node.js 2>/dev/null && echo "@elizaos/core dist OK" || echo "WARN: core dist/node missing"; \
    # @elizaos/agent: delete symlink, copy compiled package root from dist.
    # The source package.json exports ./src/*.ts, but we intentionally do not
    # ship src/ here; use dist/package.json so imports from vendored apps resolve
    # to the compiled packages/agent/src/*.js files inside the dist bundle.
    rm -rf node_modules/@elizaos/agent; \
    mkdir -p node_modules/@elizaos/agent; \
    if [ -f eliza/packages/agent/dist/package.json ]; then \
      cp -a eliza/packages/agent/dist/. node_modules/@elizaos/agent/; \
    else \
      cp eliza/packages/agent/package.json node_modules/@elizaos/agent/; \
      cp -a eliza/packages/agent/dist node_modules/@elizaos/agent/dist 2>/dev/null || true; \
    fi; \
    ls node_modules/@elizaos/agent/packages/agent/src/index.js 2>/dev/null && echo "@elizaos/agent compiled package OK" || echo "WARN: agent compiled package missing"; \
    # @elizaos/plugin-sql: replace broken npm alpha with vendored submodule build.
    # The published alpha lacks object-form countMemories() support and does not
    # register the memoryStorage service, which breaks cloud chat.
    rm -rf node_modules/@elizaos/plugin-sql; \
    mkdir -p node_modules/@elizaos/plugin-sql; \
    cp eliza/plugins/plugin-sql/typescript/package.json node_modules/@elizaos/plugin-sql/; \
    cp -a eliza/plugins/plugin-sql/typescript/dist node_modules/@elizaos/plugin-sql/dist 2>/dev/null || true; \
    ls node_modules/@elizaos/plugin-sql/dist/node/index.node.js 2>/dev/null && echo "@elizaos/plugin-sql dist OK" || echo "WARN: plugin-sql dist missing"; \
    # @elizaos/plugin-elizacloud: vendor submodule (not installed from npm due to overrides).
    rm -rf node_modules/@elizaos/plugin-elizacloud; \
    mkdir -p node_modules/@elizaos/plugin-elizacloud; \
    cp eliza/plugins/plugin-elizacloud/typescript/package.json node_modules/@elizaos/plugin-elizacloud/; \
    cp -a eliza/plugins/plugin-elizacloud/typescript/dist node_modules/@elizaos/plugin-elizacloud/dist 2>/dev/null || true; \
    ls node_modules/@elizaos/plugin-elizacloud/dist/cjs/index.node.cjs 2>/dev/null && echo "@elizaos/plugin-elizacloud dist OK" || echo "WARN: plugin-elizacloud dist missing"; \
    # @elizaos/plugin-discord: vendor companion connector plugin stripped by published-only CI.
    rm -rf node_modules/@elizaos/plugin-discord; \
    mkdir -p node_modules/@elizaos/plugin-discord; \
    cp eliza/plugins/plugin-discord/typescript/package.json node_modules/@elizaos/plugin-discord/; \
    cp -a eliza/plugins/plugin-discord/typescript/dist node_modules/@elizaos/plugin-discord/dist 2>/dev/null || true; \
    ls node_modules/@elizaos/plugin-discord/dist/index.js 2>/dev/null && echo "@elizaos/plugin-discord dist OK" || echo "WARN: plugin-discord dist missing"; \
    # @elizaos/plugin-openai: vendor companion model provider plugin stripped by published-only CI.
    rm -rf node_modules/@elizaos/plugin-openai; \
    mkdir -p node_modules/@elizaos/plugin-openai; \
    cp eliza/plugins/plugin-openai/typescript/package.json node_modules/@elizaos/plugin-openai/; \
    cp -a eliza/plugins/plugin-openai/typescript/dist node_modules/@elizaos/plugin-openai/dist 2>/dev/null || true; \
    cp -a eliza/plugins/plugin-openai/typescript/rust node_modules/@elizaos/plugin-openai/rust 2>/dev/null || true; \
    ls node_modules/@elizaos/plugin-openai/dist/node/index.node.js 2>/dev/null && echo "@elizaos/plugin-openai dist OK" || echo "WARN: plugin-openai dist missing"; \
    # @elizaos/plugin-evm: vendor companion wallet plugin stripped by published-only CI.
    rm -rf node_modules/@elizaos/plugin-evm; \
    mkdir -p node_modules/@elizaos/plugin-evm; \
    cp eliza/plugins/plugin-evm/typescript/package.json node_modules/@elizaos/plugin-evm/; \
    cp -a eliza/plugins/plugin-evm/typescript/dist node_modules/@elizaos/plugin-evm/dist 2>/dev/null || true; \
    mkdir -p node_modules/@elizaos; \
    cp -a eliza/plugins/plugin-evm/rust node_modules/@elizaos/rust 2>/dev/null || true; \
    ls node_modules/@elizaos/plugin-evm/dist/index.js 2>/dev/null && echo "@elizaos/plugin-evm dist OK" || echo "WARN: plugin-evm dist missing"; \
    # @elizaos/plugin-pdf: statically imported by eliza runtime, so it must exist even if not config-selected.
    rm -rf node_modules/@elizaos/plugin-pdf; \
    mkdir -p node_modules/@elizaos/plugin-pdf; \
    cp eliza/plugins/plugin-pdf/typescript/package.json node_modules/@elizaos/plugin-pdf/; \
    cp -a eliza/plugins/plugin-pdf/typescript/dist node_modules/@elizaos/plugin-pdf/dist 2>/dev/null || true; \
    ls node_modules/@elizaos/plugin-pdf/dist/node/index.node.js 2>/dev/null && echo "@elizaos/plugin-pdf dist OK" || echo "WARN: plugin-pdf dist missing"; \
    # @elizaos/plugin-agent-orchestrator: enables SWARM_COORDINATOR / coding-agent coordinator services.
    rm -rf node_modules/@elizaos/plugin-agent-orchestrator; \
    mkdir -p node_modules/@elizaos/plugin-agent-orchestrator; \
    cp eliza/plugins/plugin-agent-orchestrator/package.json node_modules/@elizaos/plugin-agent-orchestrator/; \
    cp -a eliza/plugins/plugin-agent-orchestrator/dist node_modules/@elizaos/plugin-agent-orchestrator/dist 2>/dev/null || true; \
    cp -a eliza/plugins/plugin-agent-orchestrator/scripts node_modules/@elizaos/plugin-agent-orchestrator/scripts 2>/dev/null || true; \
    ls node_modules/@elizaos/plugin-agent-orchestrator/dist/index.js 2>/dev/null && echo "@elizaos/plugin-agent-orchestrator dist OK" || echo "WARN: plugin-agent-orchestrator dist missing"; \
    # @elizaos/plugin-telegram: vendor plugin package, while later stubs keep cloud-only account-auth helpers safe.
    rm -rf node_modules/@elizaos/plugin-telegram; \
    mkdir -p node_modules/@elizaos/plugin-telegram; \
    cp eliza/plugins/plugin-telegram/package.json node_modules/@elizaos/plugin-telegram/; \
    cp -a eliza/plugins/plugin-telegram/dist node_modules/@elizaos/plugin-telegram/dist 2>/dev/null || true; \
    ls node_modules/@elizaos/plugin-telegram/dist/index.js 2>/dev/null && echo "@elizaos/plugin-telegram dist OK" || echo "WARN: plugin-telegram dist missing"; \
    # @elizaos/shared: DON'T replace — the npm version or resolved workspace symlink works.
    # Workspace package.json exports point to ./src/*.ts (tsx handles this).
    # Replacing with dist-only breaks resolution since exports don't match dist layout.
    # @elizaos/app-training and sibling runtime apps: copy real package contents
    # instead of falling through to the cloud route stubs below. The develop-side
    # agent now statically imports root named exports such as loadTrainingConfig,
    # TxService, and wireCoordinatorBridgesWhenReady; the old 0.0.0-cloud-stub
    # packages only covered optional route/plugin registration subpaths.
    rm -rf node_modules/@elizaos/app-training; \
    mkdir -p node_modules/@elizaos/app-training; \
    cp eliza/apps/app-training/package.json node_modules/@elizaos/app-training/; \
    cp -a eliza/apps/app-training/src node_modules/@elizaos/app-training/src 2>/dev/null || true; \
    ls node_modules/@elizaos/app-training/src/core/index.ts 2>/dev/null && echo "@elizaos/app-training src OK" || echo "WARN: app-training src missing"; \
    rm -rf node_modules/@elizaos/app-steward; \
    mkdir -p node_modules/@elizaos/app-steward; \
    cp eliza/apps/app-steward/package.json node_modules/@elizaos/app-steward/; \
    cp -a eliza/apps/app-steward/src node_modules/@elizaos/app-steward/src 2>/dev/null || true; \
    ls node_modules/@elizaos/app-steward/src/index.ts 2>/dev/null && echo "@elizaos/app-steward src OK" || echo "WARN: app-steward src missing"; \
    rm -rf node_modules/@elizaos/app-task-coordinator; \
    mkdir -p node_modules/@elizaos/app-task-coordinator; \
    cp eliza/apps/app-task-coordinator/package.json node_modules/@elizaos/app-task-coordinator/; \
    cp -a eliza/apps/app-task-coordinator/src node_modules/@elizaos/app-task-coordinator/src 2>/dev/null || true; \
    ls node_modules/@elizaos/app-task-coordinator/src/index.ts 2>/dev/null && echo "@elizaos/app-task-coordinator src OK" || echo "WARN: app-task-coordinator src missing"; \
    rm -rf node_modules/@elizaos/app-vincent; \
    mkdir -p node_modules/@elizaos/app-vincent; \
    cp eliza/apps/app-vincent/package.json node_modules/@elizaos/app-vincent/; \
    cp -a eliza/apps/app-vincent/src node_modules/@elizaos/app-vincent/src 2>/dev/null || true; \
    ls node_modules/@elizaos/app-vincent/src/plugin.ts 2>/dev/null && echo "@elizaos/app-vincent src OK" || echo "WARN: app-vincent src missing"; \
    # @elizaos/app-companion: copy real package contents instead of relying on a workspace symlink
    # The runtime executes agent/src under tsx, and static imports like
    # @elizaos/app-companion/plugin must resolve through node_modules at runtime.
    rm -rf node_modules/@elizaos/app-companion; \
    mkdir -p node_modules/@elizaos/app-companion; \
    cp eliza/apps/app-companion/package.json node_modules/@elizaos/app-companion/; \
    cp -a eliza/apps/app-companion/src node_modules/@elizaos/app-companion/src 2>/dev/null || true; \
    cp eliza/apps/app-companion/assets.json node_modules/@elizaos/app-companion/assets.json 2>/dev/null || true; \
    ls node_modules/@elizaos/app-companion/src/plugin.ts 2>/dev/null && echo "@elizaos/app-companion src OK" || echo "WARN: app-companion src missing"; \
    # @elizaos/app-lifeops: runtime statically imports /plugin, so ship real package contents
    rm -rf node_modules/@elizaos/app-lifeops; \
    mkdir -p node_modules/@elizaos/app-lifeops; \
    cp eliza/apps/app-lifeops/package.json node_modules/@elizaos/app-lifeops/; \
    cp -a eliza/apps/app-lifeops/src node_modules/@elizaos/app-lifeops/src 2>/dev/null || true; \
    ls node_modules/@elizaos/app-lifeops/src/plugin.ts 2>/dev/null && echo "@elizaos/app-lifeops src OK" || echo "WARN: app-lifeops src missing"
# Patch vendored app package roots for the Node runtime. The real workspace
# source packages deliberately include UI exports from their root index for the
# browser build, but cloud startup imports server symbols from those roots. If
# Node evaluates UI exports here it pulls @elizaos/ui/React-only modules that are
# not part of the backend runtime image. Keep the real src + subpath exports,
# but point the package root at a server-safe cloud index.
RUN node - <<'__APP_ROOT_PATCH__'
const fs = require('fs');
function patchRoot(name, code) {
  const dir = `node_modules/${name}`;
  const pkgPath = `${dir}/package.json`;
  if (!fs.existsSync(pkgPath)) {
    console.log(`[app-root-patch] skip missing ${name}`);
    return;
  }
  fs.writeFileSync(`${dir}/cloud-runtime-index.mjs`, code.trimStart());
  const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf8'));
  pkg.type = 'module';
  if (!pkg.exports || typeof pkg.exports !== 'object') pkg.exports = {};
  pkg.exports['.'] = './cloud-runtime-index.mjs';
  fs.writeFileSync(pkgPath, JSON.stringify(pkg, null, 2));
  console.log(`[app-root-patch] ${name} root -> cloud-runtime-index.mjs`);
}
patchRoot('@elizaos/app-training', `
export * from './src/routes/index.ts';
export * from './src/services/index.ts';
export * from './src/core/index.ts';
`);
patchRoot('@elizaos/app-steward', `
export * from './src/api/tx-service.ts';
export * from './src/api/wallet-dex-prices.ts';
export * from './src/browser-workspace-wallet.ts';
export * from './src/chain-utils.ts';
export { stewardPlugin } from './src/plugin.ts';
export * from './src/routes/server-wallet-trade.ts';
export {
  approveStewardTransaction,
  buildStewardHeaders,
  createStewardClient,
  denyStewardTransaction,
  ensureStewardAgent,
  __resetStewardAgentEnsured,
  formatStewardError,
  getRecentWebhookEvents,
  getStewardBalance,
  getStewardBridgeStatus,
  getStewardHistory,
  getStewardPendingApprovals as getStewardBridgePendingApprovals,
  getStewardTokenBalances,
  getStewardWalletAddresses,
  isStewardConfigured,
  provisionStewardWallet,
  pushWebhookEvent,
  registerStewardWebhook,
  resolveStewardAgentId,
  signTransactionWithOptionalSteward,
  signViaSteward,
  tryRegisterStewardWebhook,
} from './src/routes/steward-bridge.ts';
export * from './src/security/hydrate-wallet-keys-from-platform-store.ts';
export * from './src/security/wallet-os-store-actions.ts';
export * from './src/services/privy-wallets.ts';
export { loadStewardCredentials, saveStewardCredentials } from './src/services/steward-credentials.ts';
export * from './src/services/steward-evm-bridge.ts';
export * from './src/services/steward-sidecar.ts';
export * from './src/services/steward-wallet.ts';
export * from './src/types/index.ts';
`);
patchRoot('@elizaos/app-task-coordinator', `
export * from './src/api/coordinator-types.ts';
export * from './src/api/coordinator-wiring.ts';
export * from './src/api/task-agent-message-routing.ts';
export * from './src/api/coding-agents-auth-sanitize.ts';
export * from './src/api/coding-agents-preflight-normalize.ts';
export * from './src/evals/coordinator-eval-client.ts';
export * from './src/evals/coordinator-live-runner.ts';
export * from './src/evals/coordinator-preflight.ts';
export * from './src/evals/coordinator-scenarios.ts';
`);
patchRoot('@elizaos/app-vincent', `
export { vincentPlugin } from './src/plugin.ts';
export * from './src/routes.ts';
export { VINCENT_APP_NAME, vincentApp } from './src/vincent-app.ts';
`);
patchRoot('@elizaos/app-companion', `
export * from './src/emotes/index.ts';
export { emoteAction } from './src/actions/emote.ts';
export { appCompanionPlugin, default } from './src/plugin.ts';
`);
__APP_ROOT_PATCH__

# Link any remaining missing workspace app packages to node_modules
RUN for app_dir in eliza/apps/app-coding eliza/apps/app-shopify; do \
      if [ -d "$app_dir" ]; then \
        PKG_NAME=$(node -p "require('./${app_dir}/package.json').name" 2>/dev/null); \
        if [ -n "$PKG_NAME" ] && [ ! -e "node_modules/$PKG_NAME" ]; then \
          mkdir -p "node_modules/$(dirname $PKG_NAME)"; \
          ln -s "../../$app_dir" "node_modules/$PKG_NAME"; \
          echo "Linked: $PKG_NAME -> $app_dir"; \
        fi; \
      fi; \
    done
# Remove broken nested @elizaos/core/plugin-sql entries in eliza subdirs.
# bun creates workspace symlinks like eliza/apps/app-lifeops/node_modules/@elizaos/core
# and @elizaos/plugin-sql that resolve correctly in CI but point nowhere in Docker.
# Removing them forces Node's module resolution to walk up to root node_modules.
RUN find eliza \( -path '*/node_modules/@elizaos/core' -o -path '*/node_modules/@elizaos/plugin-sql' -o -path '*/node_modules/@elizaos/plugin-elizacloud' -o -path '*/node_modules/@elizaos/plugin-discord' -o -path '*/node_modules/@elizaos/plugin-openai' -o -path '*/node_modules/@elizaos/plugin-evm' -o -path '*/node_modules/@elizaos/plugin-pdf' -o -path '*/node_modules/@elizaos/plugin-agent-orchestrator' -o -path '*/node_modules/@elizaos/plugin-telegram' \) -not -path '*/node_modules/.bun/*' \
    | while read p; do rm -rf "$p" && echo "Removed nested: $p"; done; true

# ===== End symlink replacement =====

# Delete raw TypeScript source from eliza workspace packages.
# tsx prefers .ts over compiled .js, causing cascading dep resolution failures.
# eliza/packages/typescript/src is kept because tsx resolves @elizaos/core imports via
# tsconfig paths that point here (e.g. @elizaos/core/utils/context-catalog). Removing it
# breaks agent startup even though the compiled dist is also present.

# Patch noble packages for eliza runtime compatibility.
# - @noble/ciphers and @noble/curves need extensionless subpath aliases.
# - @noble/hashes no longer needs a custom ./legacy shim, crypto-compat imports legacy.js directly.
RUN node - <<'__NOBLE_PATCH__'
const fs = require('fs');
const path = require('path');
function patchExtensionlessExports(dir) {
  const pkgPath = path.join(dir, 'package.json');
  if (!fs.existsSync(pkgPath)) return;
  const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf8'));
  if (!pkg.exports) return pkg;
  let changed = false;
  const entries = Object.entries(pkg.exports);
  for (const [key, val] of entries) {
    if (key.endsWith('.js')) {
      const stripped = key.slice(0, -3);
      if (!pkg.exports[stripped]) {
        pkg.exports[stripped] = val;
        changed = true;
      }
    }
  }
  if (changed) {
    fs.writeFileSync(pkgPath, JSON.stringify(pkg, null, 2));
    console.log('[patch-deps] Patched ' + pkg.name + ' exports: added extensionless aliases.');
  }
  return pkg;
}
patchExtensionlessExports('node_modules/@noble/ciphers');
patchExtensionlessExports('node_modules/@noble/curves');
patchExtensionlessExports('node_modules/@noble/hashes');
__NOBLE_PATCH__

# Fix dist layout: package.json says dist/index.node.js but build creates dist/node/index.node.js
RUN CORE_DIR="node_modules/@elizaos/core"; \
    if [ -f "$CORE_DIR/dist/node/index.node.js" ] && [ ! -f "$CORE_DIR/dist/index.node.js" ]; then \
      ln -s node/index.node.js "$CORE_DIR/dist/index.node.js"; \
      echo "Linked dist/index.node.js -> dist/node/index.node.js"; \
    fi; \
    if [ -f "$CORE_DIR/dist/browser/index.browser.js" ] && [ ! -f "$CORE_DIR/dist/index.browser.js" ]; then \
      ln -s browser/index.browser.js "$CORE_DIR/dist/index.browser.js"; \
    fi

# Hoist missing deps from workspace packages to top-level node_modules
# tsx resolves raw .ts source which imports packages not hoisted by bun
RUN for pkg_dir in eliza/packages/typescript eliza/packages/shared eliza/packages/agent eliza/apps/app-training eliza/apps/app-steward eliza/apps/app-task-coordinator eliza/apps/app-vincent eliza/apps/app-companion eliza/apps/app-lifeops; do \
      if [ -d "$pkg_dir/node_modules" ]; then \
        for dep in $(ls "$pkg_dir/node_modules/" 2>/dev/null | grep -v '^\.'); do \
          if [ ! -e "node_modules/$dep" ] && [ -d "$pkg_dir/node_modules/$dep" ]; then \
            cp -a "$pkg_dir/node_modules/$dep" "node_modules/$dep"; \
            echo "Hoisted: $dep"; \
          fi; \
        done; \
        for scope in $(ls "$pkg_dir/node_modules/@"* 2>/dev/null -d | xargs -I{} basename {}); do \
          if [ -d "$pkg_dir/node_modules/@$scope" ]; then \
            mkdir -p "node_modules/@$scope"; \
            for dep in $(ls "$pkg_dir/node_modules/@$scope/" 2>/dev/null); do \
              if [ ! -e "node_modules/@$scope/$dep" ]; then \
                cp -a "$pkg_dir/node_modules/@$scope/$dep" "node_modules/@$scope/$dep"; \
                echo "Hoisted: @$scope/$dep"; \
              fi; \
            done; \
          fi; \
        done; \
      fi; \
    done

# Two-phase fix for missing workspace plugins and their deps:
#
# Phase 1: Hoist packages from node_modules/.bun/ to node_modules/.
# bun resolves packages and stores them in .bun/ but when workspace:* entries
# have empty plugin dirs, the hoisting symlinks are never created. Copy them.
#
# Phase 2: Tarball-install packages NOT in .bun/ at all (published to npm with
# workspace:* in their own deps, so npm install fails for them too).
RUN node - <<'__HOIST__'
const fs = require('fs');
const path = require('path');
const { execSync } = require('child_process');
const https = require('https');

// isAccessible: follows symlinks, returns false for broken symlinks
function isAccessible(p) { return fs.existsSync(p); }
// symlinkExists: uses lstatSync, returns true even for broken symlinks
function symlinkExists(p) { try { fs.lstatSync(p); return true; } catch(e) { return false; } }
// ensureDst: removes broken symlinks so cp -r can proceed cleanly
function ensureDst(dst, packageName) {
  const forceBunLink = new Set([
    '@discordjs/builders',
    'discord-api-types',
    '@mysten/sui',
    '@noble/hashes',
  ]);
  if (forceBunLink.has(packageName)) {
    execSync('rm -rf "' + dst + '"');
    return true;
  }
  if (isAccessible(dst)) return false; // real dir/file exists, skip
  if (symlinkExists(dst)) fs.unlinkSync(dst); // delete broken symlink
  return true; // proceed with link
}
function linkDir(src, dst) {
  fs.mkdirSync(path.dirname(dst), {recursive:true});
  const rel = path.relative(path.dirname(dst), src);
  try { fs.symlinkSync(rel, dst, 'dir'); }
  catch (e) {
    execSync('cp -a "' + src + '" "' + dst + '"');
  }
}

// --- Phase 1: Hoist .bun/ -> node_modules/ ---
// bun stores packages in .bun/<name@ver>/node_modules/<scope>/<pkg>/ but
// doesn't create root-level node_modules symlinks when workspace:* entries
// have empty plugin dirs. Also, bun may create broken relative symlinks for
// packages in the CI workspace that don't resolve inside Docker. Replace both.
const bunDir = 'node_modules/.bun';
let hoisted = 0;
if (fs.existsSync(bunDir)) {
  for (const entry of fs.readdirSync(bunDir)) {
    const nmPath = path.join(bunDir, entry, 'node_modules');
    if (!fs.existsSync(nmPath)) continue;
    for (const pkg of fs.readdirSync(nmPath)) {
      if (pkg.startsWith('@')) {
        const scopeDir = path.join(nmPath, pkg);
        try { if (!fs.statSync(scopeDir).isDirectory()) continue; } catch(e) { continue; }
        fs.mkdirSync(path.join('node_modules', pkg), {recursive:true});
        for (const sub of fs.readdirSync(scopeDir)) {
          const src = path.join(scopeDir, sub);
          const dst = path.join('node_modules', pkg, sub);
          try {
            const packageName = pkg + '/' + sub;
            if (ensureDst(dst, packageName) && fs.statSync(src).isDirectory()) {
              linkDir(src, dst);
              hoisted++;
            }
          } catch(e) { /* skip broken .bun entries */ }
        }
      } else {
        const src = path.join(nmPath, pkg);
        const dst = path.join('node_modules', pkg);
        try {
          if (ensureDst(dst, pkg) && fs.statSync(src).isDirectory()) {
            linkDir(src, dst);
            hoisted++;
          }
        } catch(e) { /* skip */ }
      }
    }
  }
}
console.log('Phase 1: hoisted ' + hoisted + ' packages from .bun/');

// --- Phase 2: Tarball-install packages not in .bun/ ---
// These plugins publish to npm with workspace:* deps so npm install fails.
// We only need the package itself; @elizaos/core and other @elizaos/* are
// already in the image from the main bun install.
function installTarball(name, cb) {
  const pkgDir = 'node_modules/' + name;
  if (fs.existsSync(pkgDir + '/package.json')) {
    console.log('Phase 2: already present: ' + name);
    return cb && cb();
  }
  const url = execSync('npm view ' + name + ' dist.tarball 2>/dev/null', {encoding:'utf8'}).trim();
  if (!url) { console.log('Phase 2 WARN: no tarball for ' + name); return cb && cb(); }
  const tmp = '/tmp/tb_' + name.replace(/[^a-z0-9]/gi,'_');
  https.get(url, res => {
    const chunks = [];
    res.on('data', c => chunks.push(c));
    res.on('end', () => {
      try {
        fs.mkdirSync(tmp, {recursive:true});
        fs.writeFileSync(tmp + '.tgz', Buffer.concat(chunks));
        execSync('tar xz -C ' + tmp + ' -f ' + tmp + '.tgz');
        const scope = name.startsWith('@') ? name.split('/')[0] : null;
        if (scope) fs.mkdirSync('node_modules/' + scope, {recursive:true});
        execSync('rm -rf ' + pkgDir);
        execSync('mv ' + tmp + '/package ' + pkgDir);
        const v = JSON.parse(fs.readFileSync(pkgDir + '/package.json','utf8')).version;
        console.log('Phase 2: installed ' + name + '@' + v);
      } catch(e) { console.error('Phase 2 WARN ' + name + ': ' + e.message); }
      cb && cb();
    });
  }).on('error', e => { console.error('Phase 2 WARN ' + name + ': ' + e.message); cb && cb(); });
}
const phase2 = [
  '@elizaos/plugin-agent-skills',
  '@elizaos/plugin-anthropic',
  '@elizaos/plugin-local-embedding',
  'jsonrepair',
];
(function next(i) { if (i >= phase2.length) return; installTarball(phase2[i], () => next(i+1)); })(0);
__HOIST__

# Patch plugin-agent-skills getCatalogStats crash (alpha.11 vs alpha.66 interface mismatch)
RUN sed -i 's/const stats = service.getCatalogStats();/const stats = typeof service.getCatalogStats === "function" ? service.getCatalogStats() : { loaded: 0, total: 0, storageType: "unknown" };/g' node_modules/@elizaos/plugin-agent-skills/dist/index.js 2>/dev/null || true
ARG VERSION_CLEAN

# Patch autonomous version
RUN if [ -n "${VERSION_CLEAN}" ]; then \
  node -e " \
  const fs = require('fs'); \
  const v = '${VERSION_CLEAN}'; \
  try { \
  const p = JSON.parse(fs.readFileSync('node_modules/@elizaos/agent/package.json', 'utf8')); \
  p.version = v; \
  fs.writeFileSync('node_modules/@elizaos/agent/package.json', JSON.stringify(p, null, 2)); \
  console.log('Patched autonomous to', v); \
  } catch(e) { console.log('skip:', e.message); } \
  "; \
  fi

# Stub heavy native ML deps that plugin-local-embedding imports at boot.
# onnxruntime-node is a large native binary (~100MB) not needed in cloud.
# Create no-op stubs so the import succeeds without crashing the agent.
RUN node - <<'__STUBS__'
const fs = require('fs');
// ESM stub: exports a Proxy default + common named exports so both
// `import pkg` and `import { AutoTokenizer }` resolve without crashing.
const esmStub = `
const handler = { get: () => new Proxy(() => {}, { get: () => new Proxy(() => {}, { apply: () => Promise.resolve({}), get: () => () => {} }) }) };
const stub = new Proxy({}, handler);
export default stub;
export const AutoTokenizer = stub;
export const PreTrainedTokenizer = stub;
export const env = stub;
`;
const nativeActivityTrackerStub = `
export function isSupportedPlatform() { return false; }
export function startActivityCollector() { throw new Error('[activity-tracker] Native collector only runs on Darwin.'); }
export const __internal = { parseEventLine: () => null };
export default { isSupportedPlatform, startActivityCollector, __internal };
`;
// CJS stub for packages that don't need named ESM exports
const cjsNoop = 'const stub = new Proxy({}, { get: () => new Proxy(()=>{},{get:()=>new Proxy(()=>{},{apply:()=>Promise.resolve({}),get:()=>()=>{}})}) }); module.exports = stub; module.exports.default = stub;';
const pkgs = [
  ['@huggingface/transformers', esmStub, true],
  ['@huggingface/tokenizers', esmStub, true],
  ['@elizaos/native-activity-tracker', nativeActivityTrackerStub, true],
  ['onnxruntime-node', cjsNoop, false],
  ['onnxruntime-web', cjsNoop, false],
];
for (const [name, code, esm] of pkgs) {
  const dir = 'node_modules/' + name;
  if (!fs.existsSync(dir + '/package.json')) {
    const scope = name.startsWith('@') ? name.split('/')[0] : null;
    if (scope) fs.mkdirSync('node_modules/' + scope, {recursive:true});
    fs.mkdirSync(dir, {recursive:true});
    const pkg = {name, version:'0.0.0-cloud-stub'};
    if (esm) {
      pkg.type = 'module';
      pkg.main = 'index.mjs';
      fs.writeFileSync(dir + '/index.mjs', code);
    } else {
      pkg.main = 'index.js';
      fs.writeFileSync(dir + '/index.js', code);
    }
    fs.writeFileSync(dir + '/package.json', JSON.stringify(pkg));
    console.log('stubbed: ' + name + (esm ? ' (esm)' : ' (cjs)'));
  } else {
    console.log('present: ' + name);
  }
}
__STUBS__

# Stub missing @elizaos/app-* packages used by registerAppRoutePlugins.
