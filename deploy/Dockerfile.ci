# syntax=docker/dockerfile:1.7
# Milady/elizaOS cloud image — workspace-native build.
#
# Structural invariant: do not vendor individual @elizaos/* packages into
# node_modules. The full milady + eliza workspace is copied, Bun installs at the
# workspace root, and workspace symlinks are preserved into the runtime image.
ARG NODE_VERSION=22
ARG BUN_VERSION=1.3.11
ARG APP_ENTRYPOINT=milady.mjs
ARG APP_CMD_START=""
ARG APP_PORT=2138
ARG APP_API_BIND=127.0.0.1
ARG OCI_SOURCE=""
ARG OCI_TITLE="Milady Agent"
ARG OCI_DESCRIPTION="Milady agent runtime"
ARG OCI_LICENSES="MIT"
ARG VERSION=""
ARG VERSION_CLEAN=""
ARG REVISION=""

FROM node:${NODE_VERSION}-slim AS runtime

ARG BUN_VERSION
ARG APP_ENTRYPOINT
ARG APP_CMD_START
ARG APP_PORT
ARG APP_API_BIND
ARG OCI_SOURCE
ARG OCI_TITLE
ARG OCI_DESCRIPTION
ARG OCI_LICENSES
ARG VERSION
ARG VERSION_CLEAN
ARG REVISION

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    bash ca-certificates curl git python3 make g++ pkg-config \
  && rm -rf /var/lib/apt/lists/* \
  && npm install -g "bun@${BUN_VERSION}"

ENV SKIP_AVATAR_CLONE=1 \
    MILADY_NO_VISION_DEPS=1 \
    MILADY_SKIP_LOCAL_UPSTREAMS=1 \
    NODE_ENV=production

COPY . .

# Bun workspace install at the milady root. This is the core fix: all
# @elizaos/* workspace packages resolve through Bun's workspace symlinks rather
# than Dockerfile-created synthetic node_modules packages.
RUN --mount=type=cache,target=/root/.bun/install/cache \
  bun install --frozen-lockfile --ignore-scripts \
  && bun run postinstall

# Source-level compatibility fix for a nested plugin submodule that has not yet
# exported its Telegram account-auth service from the root barrel.
RUN node - <<'__WORKSPACE_SOURCE_PATCHES__'
const fs = require('fs');
const telegramIndex = 'eliza/plugins/plugin-telegram/src/index.ts';
if (fs.existsSync(telegramIndex)) {
  let source = fs.readFileSync(telegramIndex, 'utf8');
  if (!source.includes("account-auth-service.js")) {
    source += "\nexport * from './account-auth-service.js';\n";
    fs.writeFileSync(telegramIndex, source);
    console.log('[workspace-patch] exported plugin-telegram account-auth-service');
  }
}
__WORKSPACE_SOURCE_PATCHES__

# Build the workspace packages that publish compiled node/browser outputs.
# Some upstream plugin build scripts emit usable JS and then fail declaration
# generation under the CI TypeScript/Bun matrix; keep going when the expected JS
# already exists, and let the smoke contract catch runtime import breakage.
RUN set -eux; \
  cd eliza/packages/schemas; \
  bunx buf dep update; \
  bunx buf generate; \
  cd ../typescript; \
  node ../shared/scripts/generate-keywords.mjs --target ts; \
  bun run build.ts; \
  cd /app; \
  (cd eliza/packages/shared && bun run build); \
  (cd eliza/packages/agent && bun run build:docker-dist); \
  for d in \
    eliza/packages/ui \
    eliza/packages/app-core \
    eliza/cloud/packages/sdk \
    eliza/plugins/plugin-cli/typescript \
    eliza/plugins/plugin-cron/typescript \
    eliza/plugins/plugin-sql/typescript \
    eliza/plugins/plugin-elizacloud/typescript \
    eliza/plugins/plugin-edge-tts/typescript \
    eliza/plugins/plugin-discord/typescript \
    eliza/plugins/plugin-openai/typescript \
    eliza/plugins/plugin-evm/typescript \
    eliza/plugins/plugin-pdf/typescript \
    eliza/plugins/plugin-agent-orchestrator \
    eliza/plugins/plugin-agent-skills/typescript \
    eliza/plugins/plugin-anthropic/typescript \
    eliza/plugins/plugin-local-embedding/typescript \
    eliza/plugins/plugin-ollama/typescript \
    eliza/plugins/plugin-telegram \
    eliza/plugins/plugin-imessage/typescript; do \
      if [ -f "$d/package.json" ]; then \
        echo "[cloud-build] building $d"; \
        (cd "$d" && bun run build) || echo "[cloud-build] WARN: build failed after partial output: $d"; \
      fi; \
    done; \
  if [ ! -f eliza/plugins/plugin-cli/typescript/dist/index.js ]; then \
    echo "[cloud-build] plugin-cli produced no dist/index.js; using Bun fallback bundler"; \
    (cd eliza/plugins/plugin-cli/typescript && bun build ./src/index.ts --outdir ./dist --target node --format esm --sourcemap=linked --external node:* --external @elizaos/core --external commander && echo 'export {};' > dist/index.d.ts); \
  fi; \
  node scripts/patch-elizacloud.mjs

# Root runtime bundle + Milady React app bundle.
RUN set -eux; \
  npx tsdown; \
  echo '{"type":"module"}' > dist/package.json; \
  mkdir -p dist/registry; \
  cp -R eliza/packages/app-core/src/registry/entries dist/registry/entries; \
  node --import tsx eliza/packages/app-core/scripts/write-build-info.ts 2>/dev/null || true; \
  cd apps/app; \
  npx vite build

# Compatibility patches for third-party/published package quirks. These are not
# @elizaos workspace vendoring; they patch installed package metadata/output.
RUN node - <<'__PATCH_RUNTIME_DEPS__'
const fs = require('fs');
const path = require('path');

function patchExtensionlessExports(dir) {
  const pkgPath = path.join(dir, 'package.json');
  if (!fs.existsSync(pkgPath)) return;
  const pkg = JSON.parse(fs.readFileSync(pkgPath, 'utf8'));
  if (!pkg.exports || typeof pkg.exports !== 'object') return;
  let changed = false;
  for (const [key, value] of Object.entries({...pkg.exports})) {
    if (key.endsWith('.js')) {
      const stripped = key.slice(0, -3);
      if (!pkg.exports[stripped]) {
        pkg.exports[stripped] = value;
        changed = true;
      }
    }
  }
  if (changed) {
    fs.writeFileSync(pkgPath, JSON.stringify(pkg, null, 2));
    console.log('[patch-deps] extensionless aliases:', pkg.name || dir);
  }
}
for (const dir of ['node_modules/@noble/ciphers', 'node_modules/@noble/curves', 'node_modules/@noble/hashes']) {
  patchExtensionlessExports(dir);
}

const n8nRoot = 'node_modules/@elizaos/plugin-n8n-workflow/dist';
if (fs.existsSync(n8nRoot)) {
  const visit = (dir) => {
    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
      const full = path.join(dir, entry.name);
      if (entry.isDirectory()) { visit(full); continue; }
      if (!entry.isFile() || !entry.name.endsWith('.js')) continue;
      let source = fs.readFileSync(full, 'utf8');
      let patched = source.replace(/(from\s+['"])(\.{1,2}\/[^'"]+?)(['"])/g, (match, prefix, spec, suffix) => {
        if (spec.endsWith('.js') || spec.endsWith('.json')) return match;
        const target = path.resolve(path.dirname(full), spec);
        if (fs.existsSync(`${target}.js`)) return `${prefix}${spec}.js${suffix}`;
        if (fs.existsSync(path.join(target, 'index.js'))) return `${prefix}${spec}/index.js${suffix}`;
        return match;
      });
      patched = patched.replace(/\sassert\s*\{\s*type:\s*(['"])json\1\s*\}/g, " with { type: 'json' }");
      if (patched !== source) {
        fs.writeFileSync(full, patched);
        console.log('[patch-deps] n8n esm:', full);
      }
    }
  };
  visit(n8nRoot);
}
__PATCH_RUNTIME_DEPS__

# Runtime must resolve @elizaos/* through node_modules package exports, not
# repo-local tsconfig path aliases. The aliases are useful for Vite/typecheck,
# but in the cloud image they bypass server-safe package roots.
RUN node - <<'__RUNTIME_TSCONFIG_PATCH__'
const fs = require('fs');
const cp = require('child_process');
const files = cp.execSync("find /app -name 'tsconfig*.json' -not -path '*/node_modules/.bun/*' -not -path '*/node_modules/*'", { encoding: 'utf8' })
  .trim()
  .split(/\n+/)
  .filter(Boolean);
for (const file of files) {
  let json;
  try { json = JSON.parse(fs.readFileSync(file, 'utf8')); } catch { continue; }
  const paths = json.compilerOptions && json.compilerOptions.paths;
  if (!paths || typeof paths !== 'object') continue;
  let changed = false;
  for (const key of Object.keys(paths)) {
    if (key === '@elizaos' || key.startsWith('@elizaos/')) {
      delete paths[key];
      changed = true;
    }
  }
  if (changed) {
    if (Object.keys(paths).length === 0) delete json.compilerOptions.paths;
    fs.writeFileSync(file, JSON.stringify(json, null, 2));
    console.log('[runtime-tsconfig] removed @elizaos paths from ' + file);
  }
}
__RUNTIME_TSCONFIG_PATCH__

# Build-time smoke contract: fail the image if critical runtime package imports
# drift away from the workspace/package export graph.
RUN node --import ./node_modules/tsx/dist/loader.mjs scripts/cloud-smoke-imports.mjs

# Strip dev-only caches/artifacts while preserving workspace sources and Bun's
# .bun store (root node_modules symlinks point into it).
RUN rm -rf \
    /root/.cache /tmp/* \
    .git .github .turbo \
    eliza/.git eliza/.turbo \
    apps/app/.vite apps/app/test apps/app/test-results apps/app/screenshots \
    coverage artifacts \
  && find /app -type d \( -name .turbo -o -name __pycache__ -o -name .pytest_cache -o -name .mypy_cache -o -name .ruff_cache \) -prune -exec rm -rf {} + 2>/dev/null || true \
  && find /app -type f \( -name '*.map' -o -name '*.tsbuildinfo' \) -delete 2>/dev/null || true

LABEL org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.title="${OCI_TITLE}" \
      org.opencontainers.image.description="${OCI_DESCRIPTION}" \
      org.opencontainers.image.licenses="${OCI_LICENSES}" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}"

ENV ELIZA_DISABLE_EDGE_TTS=1 \
    APP_ENTRYPOINT=${APP_ENTRYPOINT} \
    APP_CMD_START=${APP_CMD_START} \
    APP_PORT=${APP_PORT} \
    APP_API_BIND=${APP_API_BIND} \
    ELIZA_PORT=${APP_PORT} \
    ELIZA_API_BIND=${APP_API_BIND} \
    ELIZA_BUNDLED_VERSION=${VERSION_CLEAN} \
    ELIZA_ALLOWED_HOSTS=*

EXPOSE ${APP_PORT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD sh -lc 'port="${PORT:-${APP_PORT:-${ELIZA_PORT:-2138}}}"; code="$(curl -s -o /dev/null -w "%{http_code}" "http://127.0.0.1:${port}/api/health")" && [ "$code" = "200" -o "$code" = "401" ]'

ENTRYPOINT ["sh", "./eliza/packages/app-core/scripts/docker-entrypoint.sh"]
CMD ["sh", "-lc", "exec ${APP_CMD_START:-node --import ./node_modules/tsx/dist/loader.mjs ${APP_ENTRYPOINT} start}"]
