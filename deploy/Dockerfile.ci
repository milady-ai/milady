# Stub workspace-only plugins that are referenced via guarded runtime require().
# Cloud builds can omit their workspace symlinks entirely, and some published
# tarballs have incomplete dist/ output, so provide a dual ESM/CJS no-op module.
RUN node - <<'__PLUGIN_STUBS__'
const fs = require('fs');
function ensureStubDir(dir) {
  try {
    const st = fs.lstatSync(dir);
    if (st.isSymbolicLink() || !st.isDirectory()) {
      fs.rmSync(dir, { force: true, recursive: true });
    } else if (fs.existsSync(dir + '/package.json')) {
      return 'present';
    }
  } catch (err) {
    // doesn't exist yet
  }
  if (!fs.existsSync(dir)) {
    fs.mkdirSync(dir, { recursive: true });
  }
  return 'stub';
}
const plugins = [
  {
    name: '@elizaos/plugin-cron',
    exportName: 'cronPlugin',
    extraEsm: `export class CronService {}\n`,
    extraCjs: `module.exports.CronService = class CronService {};\n`,
  },
  {
    name: '@elizaos/plugin-shell',
    exportName: 'shellPlugin',
    extraEsm: `export class ShellService {}\n`,
    extraCjs: `module.exports.ShellService = class ShellService {};\n`,
  },
  {
    name: '@elizaos/plugin-commands',
    exportName: 'commandsPlugin',
    extraEsm: `
const commandStore = new Map();
export function registerCommand(cmd) {
  if (!cmd || typeof cmd !== 'object') return;
  const key = typeof cmd.key === 'string' ? cmd.key : String(commandStore.size);
  commandStore.set(key, cmd);
}
export function initForRuntime() {}
export function getRegisteredCommands() { return Array.from(commandStore.values()); }
`,
    extraCjs: `
const commandStore = new Map();
module.exports.registerCommand = function registerCommand(cmd) {
  if (!cmd || typeof cmd !== 'object') return;
  const key = typeof cmd.key === 'string' ? cmd.key : String(commandStore.size);
  commandStore.set(key, cmd);
};
module.exports.initForRuntime = function initForRuntime() {};
module.exports.getRegisteredCommands = function getRegisteredCommands() { return Array.from(commandStore.values()); };
`,
  },
  {
    name: '@elizaos/plugin-browser-bridge',
    exportName: 'browserBridgePlugin',
    extraEsm: `export const pluginBrowserBridge = browserBridgePlugin;\nexport const plugin = browserBridgePlugin;\n`,
    extraCjs: `module.exports.pluginBrowserBridge = module.exports.browserBridgePlugin;\nmodule.exports.plugin = module.exports.browserBridgePlugin;\n`,
    extraFiles: {
      'contracts.mjs': `export const BROWSER_BRIDGE_KINDS = ['chrome', 'safari'];\nexport const BROWSER_BRIDGE_ACTION_KINDS = ['open_url', 'search', 'summarize', 'extract', 'close_tab'];\nexport const BROWSER_BRIDGE_TRACKING_MODES = ['off', 'active_tab', 'all_tabs'];\nexport const BROWSER_BRIDGE_SITE_ACCESS_MODES = ['allow_all', 'deny_all', 'allowlist'];\nexport const BROWSER_BRIDGE_COMPANION_CONNECTION_STATES = ['disconnected', 'connecting', 'connected', 'error'];\nexport const BROWSER_BRIDGE_PACKAGE_PATH_TARGETS = ['chrome', 'safari'];\n`,
      'service.mjs': `export const BROWSER_BRIDGE_ROUTE_SERVICE_TYPE = 'lifeops_browser_plugin';\nexport class BrowserBridgeRouteService {}\nexport default {};\n`,
      'schema.mjs': `export const browserBridgeSchema = {};\nexport default browserBridgeSchema;\n`,
      'packaging.mjs': `export function getBrowserBridgeCompanionPackageStatus() { return { available: false, chrome: null, safari: null }; }\nexport default { getBrowserBridgeCompanionPackageStatus };\n`,
      'routes.mjs': `export function handleBrowserBridgeRoutes() { return false; }\nexport default {};\n`,
    },
  },
];
for (const { name, exportName, extraEsm = '', extraCjs = '', extraFiles = {} } of plugins) {
  const dir = 'node_modules/' + name;
  if (ensureStubDir(dir) === 'present') {
    console.log('present: ' + name);
    continue;
  }
  const scope = name.startsWith('@') ? name.split('/')[0] : null;
  if (scope) fs.mkdirSync('node_modules/' + scope, { recursive: true });
  const shortName = name.split('/').pop().replace(/^plugin-/, '');
  const stubName = shortName + '-stub';
  const esm = `const stub = { name: '${stubName}', description: '${stubName} cloud fallback', routes: [], actions: [], providers: [], evaluators: [], services: [] };
export const ${exportName} = stub;
export default stub;
${extraEsm}`;
  const cjs = `const stub = { name: '${stubName}', description: '${stubName} cloud fallback', routes: [], actions: [], providers: [], evaluators: [], services: [] };
module.exports = stub;
module.exports.default = stub;
module.exports.${exportName} = stub;
${extraCjs}`;
  fs.writeFileSync(dir + '/index.mjs', esm);
  fs.writeFileSync(dir + '/index.cjs', cjs);
  const exportsMap = {
    '.': {
      import: './index.mjs',
      require: './index.cjs',
      default: './index.mjs'
    },
    './plugin': {
      import: './index.mjs',
      require: './index.cjs',
      default: './index.mjs'
    }
  };
  for (const [fileName, code] of Object.entries(extraFiles)) {
    fs.writeFileSync(dir + '/' + fileName, code);
    const subpath = './' + fileName.replace(/\.mjs$/, '');
    exportsMap[subpath] = {
      import: './' + fileName,
      require: './' + fileName,
      default: './' + fileName
    };
  }
  fs.writeFileSync(dir + '/package.json', JSON.stringify({
    name,
    version: '0.0.0-cloud-stub',
    type: 'module',
    main: './index.cjs',
    module: './index.mjs',
    exports: exportsMap
  }));
  console.log('stubbed: ' + name);
}
__PLUGIN_STUBS__

# Fix @ai-sdk/provider-utils version conflict:
# @ai-sdk/google@3.x needs provider-utils@4.x (exports convertToBase64),
# but bun hoisted provider-utils@2.x to top-level. Replace with the 4.x copy.
RUN node - <<'__AISDK_FIX__'
const fs = require('fs');
const path = require('path');
const bunDir = 'node_modules/.bun';
const target = 'node_modules/@ai-sdk/provider-utils';
if (fs.existsSync(bunDir)) {
  const entries = fs.readdirSync(bunDir).filter(e => e.startsWith('@ai-sdk+provider-utils@4.'));
  if (entries.length > 0) {
    // Pick the latest 4.x
    entries.sort();
    const src = path.join(bunDir, entries[entries.length - 1], 'node_modules/@ai-sdk/provider-utils');
    if (fs.existsSync(src)) {
      fs.rmSync(target, { recursive: true, force: true });
      fs.cpSync(src, target, { recursive: true });
      const ver = JSON.parse(fs.readFileSync(path.join(target, 'package.json'), 'utf8')).version;
      console.log('Upgraded @ai-sdk/provider-utils to ' + ver);
    }
  }
}
__AISDK_FIX__

# Safe pruning only (GPU binaries + obvious dead weight)
RUN rm -rf \
  node_modules/.bun/@node-llama-cpp+linux-x64-cuda-ext@* \
  node_modules/.bun/@node-llama-cpp+linux-x64-cuda@* \
  node_modules/.bun/@node-llama-cpp+linux-x64-vulkan@* \
  node_modules/.bun/@node-llama-cpp+linux-arm64@* \
  node_modules/.bun/@node-llama-cpp+linux-armv7l@* \
  node_modules/@storybook \
  node_modules/storybook \
  apps/app/public \
  2>/dev/null || true

# Remove source maps and test dirs
RUN find node_modules -name '*.map' -delete 2>/dev/null; \
  find node_modules -type d -name '__tests__' -exec rm -rf {} + 2>/dev/null; \
  find node_modules -type d -name 'test' -maxdepth 3 -exec rm -rf {} + 2>/dev/null; \
  true

FROM node:${NODE_VERSION}-slim
ARG BUN_VERSION
ARG ESBUILD_VERSION
ARG APP_ENTRYPOINT
ARG APP_CMD_START
ARG APP_PORT
ARG APP_API_BIND
ARG OCI_SOURCE
ARG OCI_TITLE
ARG OCI_DESCRIPTION
ARG OCI_LICENSES
ARG VERSION
ARG VERSION_CLEAN
ARG REVISION
LABEL org.opencontainers.image.title="${OCI_TITLE}" \
      org.opencontainers.image.description="${OCI_DESCRIPTION}" \
      org.opencontainers.image.source="${OCI_SOURCE}" \
      org.opencontainers.image.url="${OCI_SOURCE}" \
      org.opencontainers.image.version="${VERSION_CLEAN}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="${OCI_LICENSES}"
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg libopus-dev \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=pruner /app /app

# NOTE: Do NOT install esbuild globally. tsx bundles its own esbuild.
# A global esbuild binary causes a recursive fork bomb (8000+ processes)
# when tsx's loader spawns esbuild service processes.

ENV NODE_ENV=production
ENV ELIZA_DISABLE_EDGE_TTS=1
ENV APP_ENTRYPOINT=${APP_ENTRYPOINT}
ENV APP_CMD_START=${APP_CMD_START}
ENV APP_PORT=${APP_PORT}
ENV APP_API_BIND=${APP_API_BIND}
ENV ELIZA_PORT=${APP_PORT}
ENV ELIZA_API_BIND=${APP_API_BIND}
# Bake the cloud image version so the version-resolver picks it up at runtime
# (takes priority over package.json patching which can be fragile)
ENV ELIZA_BUNDLED_VERSION=${VERSION_CLEAN}
ENV ELIZA_ALLOWED_HOSTS=*
EXPOSE ${APP_PORT}

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
  CMD sh -lc 'port="${PORT:-${APP_PORT:-${ELIZA_PORT:-2138}}}"; code="$(curl -s -o /dev/null -w "%{http_code}" "http://127.0.0.1:${port}/api/health")" && [ "$code" = "200" -o "$code" = "401" ]'

ENTRYPOINT ["sh", "./eliza/packages/app-core/scripts/docker-entrypoint.sh"]
CMD ["sh", "-lc", "exec ${APP_CMD_START:-node --import ./node_modules/tsx/dist/loader.mjs ${APP_ENTRYPOINT} start}"]
