export function setElizaMakerDropService(next) { service = next ?? null; }
export function getElizaMakerDropService() { return service; }
export default { setElizaMakerDropService, getElizaMakerDropService };`);
    fs.writeFileSync(dir + '/package.json', JSON.stringify({
