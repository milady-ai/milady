{
  "name": "@miladyai/plugin-cloud-wallet",
  "version": "2.0.0-alpha.83",
  "description": "Remote-signing wallet providers that tunnel EVM and Solana signatures through Eliza Cloud.",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/milady-ai/milady.git",
    "directory": "packages/plugin-cloud-wallet"
  },
  "exports": {
    ".": "./src/index.ts",
    "./evm": "./src/providers/evm.ts",
    "./solana": "./src/providers/solana.ts",
    "./bridge": "./src/bridge/client.ts"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run build:dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:dist": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@elizaos/core": "workspace:*",
    "@solana/web3.js": "^1.98.4",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
