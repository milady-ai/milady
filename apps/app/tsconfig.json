{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "6.0",
    "experimentalDecorators": true,
    "useUnknownInCatchVariables": true,
    "types": ["vite/client", "bun-types"],
    "baseUrl": "../..",
    "paths": {
      "@elizaos/app-core": ["./eliza/packages/app-core/dist/browser.d.ts"],
      "@elizaos/app-core/platform/native-plugin-entrypoints": [
        "./eliza/packages/app-core/src/platform/native-plugin-entrypoints.ts"
      ],
      "@elizaos/app-core/*": ["./eliza/packages/app-core/dist/*"],
      "@elizaos/app-task-coordinator": [
        "./eliza/node_modules/@elizaos/app-task-coordinator"
      ],
      "@elizaos/app-contacts": ["./eliza/plugins/app-contacts/src/index.ts"],
      "@elizaos/app-contacts/*": ["./eliza/plugins/app-contacts/src/*"],
      "@elizaos/app-phone": ["./eliza/plugins/app-phone/src/index.ts"],
      "@elizaos/app-phone/*": ["./eliza/plugins/app-phone/src/*"],
      "@elizaos/app-wifi": ["./eliza/plugins/app-wifi/src/index.ts"],
      "@elizaos/app-wifi/*": ["./eliza/plugins/app-wifi/src/*"],
      "@elizaos/agent": [
        "./eliza/packages/agent/dist/packages/agent/src/index.d.ts"
      ],
      "@elizaos/agent/*": ["./eliza/packages/agent/dist/packages/agent/src/*"],
      "@elizaos/plugin-browser-bridge": [
        "./eliza/plugins/plugin-browser-bridge/src/index.ts"
      ],
      "@elizaos/plugin-browser-bridge/*": [
        "./eliza/plugins/plugin-browser-bridge/src/*"
      ],
      "@elizaos/core": ["./eliza/packages/typescript/src/index.ts"],
      "@elizaos/core/*": ["./eliza/packages/typescript/src/*"],
      "@elizaos/shared": ["./eliza/packages/shared/src/index.ts"],
      "@elizaos/shared/*": ["./eliza/packages/shared/src/*"],
      "@elizaos/capacitor-agent": [
        "./eliza/packages/native-plugins/agent/src/index.ts"
      ],
      "@elizaos/capacitor-contacts": [
        "./eliza/packages/native-plugins/contacts/src/index.ts"
      ],
      "@elizaos/capacitor-desktop": [
        "./eliza/packages/native-plugins/desktop/src/index.ts"
      ],
      "@elizaos/capacitor-phone": [
        "./eliza/packages/native-plugins/phone/src/index.ts"
      ],
      "@elizaos/capacitor-wifi": [
        "./eliza/packages/native-plugins/wifi/src/index.ts"
      ],
      "@elizaos/capacitor-llama": [
        "./eliza/packages/native-plugins/llama/src/index.ts"
      ],
      "@elizaos/capacitor-mobile-signals": [
        "./eliza/packages/native-plugins/mobile-signals/src/index.ts"
      ],
      "@elizaos/native-activity-tracker": [
        "./eliza/packages/native-plugins/activity-tracker/src/index.ts"
      ],
      "@elizaos/ui": ["./eliza/packages/ui/dist/index.d.ts"],
      "@elizaos/ui/*": ["./eliza/packages/ui/dist/*"],
      "react": ["./eliza/node_modules/@types/react/index.d.ts"],
      "react/jsx-runtime": [
        "./eliza/node_modules/@types/react/jsx-runtime.d.ts"
      ],
      "react/jsx-dev-runtime": [
        "./eliza/node_modules/@types/react/jsx-dev-runtime.d.ts"
      ],
      "react-dom": ["./eliza/node_modules/@types/react-dom/index.d.ts"],
      "react-dom/client": ["./eliza/node_modules/@types/react-dom/client.d.ts"],
      "@elizaos/*": ["./node_modules/@elizaos/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../eliza/packages/app-core/src/ambient-modules.d.ts",
    "../../eliza/packages/agent/src/external-modules.d.ts"
  ],
  "files": ["src/ambient-eliza-apps.d.ts"],
  "exclude": ["node_modules", "dist", "ios", "android", "electrobun"]
}
