{
  "name": "@miladyai/app",
  "version": "2.0.0-alpha.87",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "design-review": "node --import tsx test/design-review/run-design-review.ts",
    "lint": "bunx @biomejs/biome check src test scripts vite.config.ts vitest.config.ts vitest.e2e.config.ts playwright.ui-smoke.config.ts playwright.ui-packaged.config.ts playwright.electrobun.packaged.config.ts package.json capacitor.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "node scripts/run-ui-playwright.mjs --config playwright.ui-smoke.config.ts",
    "test:e2e:cloud-wallet": "node scripts/run-ui-playwright.mjs --config playwright.ui-smoke.config.ts test/ui-smoke/cloud-wallet-import.spec.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "plugin:build": "node ../../scripts/run-eliza-app-core-script.mjs build-native-plugins.mjs",
    "build": "node ../../scripts/run-app-web-build.mjs",
    "build:ios": "node ../../scripts/run-eliza-app-core-script.mjs run-mobile-build.mjs ios",
    "build:android": "node ../../scripts/run-eliza-app-core-script.mjs run-mobile-build.mjs android",
    "ios": "bun run build:ios && capacitor open ios",
    "android": "bun run build:android && capacitor open android",
    "cap:sync": "capacitor sync",
    "cap:sync:ios": "node ../../scripts/run-eliza-app-core-script.mjs ensure-capacitor-platform.mjs ios && capacitor sync ios",
    "cap:sync:android": "node ../../scripts/run-eliza-app-core-script.mjs ensure-capacitor-platform.mjs android && capacitor sync android",
    "cap:open:ios": "capacitor open ios",
    "cap:open:android": "capacitor open android",
    "build:web": "vite build"
  },
  "dependencies": {
    "@capacitor/android": "8.3.1",
    "@capacitor/app": "8.1.0",
    "@capacitor/barcode-scanner": "3.0.2",
    "@capacitor/browser": "8.0.0",
    "@capacitor/core": "8.3.1",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.3.1",
    "@capacitor/keyboard": "8.0.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.0.3",
    "@capacitor/status-bar": "8.0.2",
    "@elizaos/capacitor-agent": "1.0.0",
    "@elizaos/capacitor-appblocker": "1.0.0",
    "@elizaos/capacitor-camera": "1.0.0",
    "@elizaos/capacitor-canvas": "1.0.0",
    "@elizaos/capacitor-contacts": "1.0.0",
    "@elizaos/capacitor-gateway": "1.0.0",
    "@elizaos/capacitor-llama": "0.1.0",
    "@elizaos/capacitor-location": "1.0.0",
    "@elizaos/capacitor-messages": "1.0.0",
    "@elizaos/capacitor-mobile-signals": "1.0.0",
    "@elizaos/capacitor-phone": "1.0.0",
    "@elizaos/capacitor-screencapture": "1.0.0",
    "@elizaos/capacitor-swabble": "1.0.0",
    "@elizaos/capacitor-system": "1.0.0",
    "@elizaos/capacitor-talkmode": "1.0.0",
    "@elizaos/capacitor-websiteblocker": "1.0.0",
    "@pixiv/three-vrm": "^3.4.5",
    "llama-cpp-capacitor": "^0.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.182.0",
    "@elizaos/app-core": "alpha",
    "@elizaos/app-hyperscape": "alpha",
    "@elizaos/shared": "alpha"
  },
  "devDependencies": {
    "@capacitor/cli": "8.3.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react-swc": "^4.2.1",
    "buffer": "^6.0.3",
    "bun-types": "^1.3.12",
    "events": "^3.3.0",
    "jsdom": "^28.1.0",
    "pathe": "^2.0.3",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^6.0.0",
    "util": "^0.12.5",
    "vite": "^6.4.2",
    "vitest": "^2.1.9"
  }
}
