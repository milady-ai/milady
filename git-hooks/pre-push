#!/usr/bin/env bash
#
# Pre-push hook: Prevent direct pushes to protected branches and require
# local bot-style review before code leaves the machine.
#

PROTECTED_BRANCHES=("main")

while read local_ref local_sha remote_ref remote_sha; do
  remote_branch=$(echo "$remote_ref" | sed 's|refs/heads/||')

  for protected in "${PROTECTED_BRANCHES[@]}"; do
    if [ "$remote_branch" = "$protected" ]; then
      echo ""
      echo "Push to '$protected' branch is not allowed."
      echo "Create a pull request instead."
      echo ""
      exit 1
    fi
  done
done

# Skip only for emergency pushes.
if [ "${MILADY_SKIP_PRE_REVIEW:-0}" != "1" ]; then
  if command -v bun >/dev/null 2>&1; then
    echo "Running local pre-push review..."
    if ! bun run review:local; then
      echo ""
      echo "Local pre-push review failed."
      echo "Fix the issues above, or set MILADY_SKIP_PRE_REVIEW=1 to bypass once."
      echo ""
      exit 1
    fi
  fi
fi

exit 0
